---
import { SITE } from '../data/site';
---
<footer class="site-footer">
  <p>{SITE.name} · {SITE.location}</p>
  <ul>
    <li><a href={`mailto:${SITE.email}`}>E-mail</a></li>
    <li><a href={SITE.links.github}>GitHub</a></li>
    {SITE.links.linkedin && <li><a href={SITE.links.linkedin}>LinkedIn</a></li>}
  </ul>
  <p class="mono"><a href={`${SITE.links.github}/Portfolio`}>Open source</a> - fait avec Astro</p>
</footer>
